{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docxunravel.dev/schemas/migration-discovery-0.1.schema.json",
  "title": "Canonical Azure migration discovery data",
  "description": "Structured discovery input. This schema is independent from DocXUnravel template and patch contracts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fictional",
    "fictional_notice",
    "customer",
    "project",
    "source_infrastructure_inventory",
    "application_inventory",
    "application_dependencies",
    "current_state_observations",
    "proposed_azure_target_services",
    "migration_waves",
    "risks_and_assumptions",
    "security_and_networking_requirements",
    "outstanding_design_decisions"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "fictional": {"const": true},
    "fictional_notice": {"type": "string", "minLength": 20},
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "industry", "primary_region", "contact_name"],
      "properties": {
        "name": {"type": "string"},
        "industry": {"type": "string"},
        "primary_region": {"type": "string"},
        "contact_name": {"type": "string"}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sponsor", "owner", "scope", "target_start", "target_completion"],
      "properties": {
        "name": {"type": "string"},
        "sponsor": {"type": "string"},
        "owner": {"type": "string"},
        "scope": {"type": "string"},
        "target_start": {"type": "string", "format": "date"},
        "target_completion": {"type": "string", "format": "date"}
      }
    },
    "source_infrastructure_inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "category", "location", "quantity", "operating_system", "specification"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "category": {"enum": ["compute", "database", "storage", "network", "platform"]},
          "location": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 0},
          "operating_system": {"type": "string"},
          "specification": {"type": "string"}
        }
      }
    },
    "application_inventory": {
      "type": "array",
      "items": {"$ref": "#/$defs/application"}
    },
    "application_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_application_id", "target_application_id", "dependency_type", "notes"],
        "properties": {
          "source_application_id": {"type": "string"},
          "target_application_id": {"type": "string"},
          "dependency_type": {"enum": ["synchronous", "asynchronous", "data", "identity", "file"]},
          "notes": {"type": "string"}
        }
      }
    },
    "current_state_observations": {
      "type": "array",
      "items": {"$ref": "#/$defs/observation"}
    },
    "proposed_azure_target_services": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workload", "azure_service", "region", "rationale"],
        "properties": {
          "workload": {"type": "string"},
          "azure_service": {"type": "string"},
          "region": {"type": "string"},
          "rationale": {"type": "string"}
        }
      }
    },
    "migration_waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["wave", "name", "application_ids", "target_start", "target_end", "exit_criteria"],
        "properties": {
          "wave": {"type": "integer", "minimum": 1},
          "name": {"type": "string"},
          "application_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "target_start": {"type": "string", "format": "date"},
          "target_end": {"type": "string", "format": "date"},
          "exit_criteria": {"type": "string"}
        }
      }
    },
    "risks_and_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risks", "assumptions"],
      "properties": {
        "risks": {"type": "array", "items": {"$ref": "#/$defs/risk"}},
        "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}}
      }
    },
    "security_and_networking_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security", "networking"],
      "properties": {
        "security": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
        "networking": {"type": "array", "items": {"$ref": "#/$defs/requirement"}}
      }
    },
    "outstanding_design_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision", "owner", "due_date", "status"],
        "properties": {
          "id": {"type": "string"},
          "decision": {"type": "string"},
          "owner": {"type": "string"},
          "due_date": {"type": "string", "format": "date"},
          "status": {"enum": ["open", "in_review", "decided"]}
        }
      }
    }
  },
  "$defs": {
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "business_criticality", "current_hosting", "data_classification", "migration_disposition"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "owner": {"type": "string"},
        "business_criticality": {"enum": ["critical", "high", "medium", "low"]},
        "current_hosting": {"type": "string"},
        "data_classification": {"enum": ["public", "internal", "confidential", "restricted"]},
        "migration_disposition": {"enum": ["rehost", "replatform", "refactor", "repurchase", "retain", "retire"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "observation", "impact"],
      "properties": {
        "category": {"type": "string"},
        "observation": {"type": "string"},
        "impact": {"type": "string"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "likelihood", "impact", "mitigation"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "likelihood": {"enum": ["low", "medium", "high"]},
        "impact": {"enum": ["low", "medium", "high"]},
        "mitigation": {"type": "string"}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "validation_owner"],
      "properties": {
        "id": {"type": "string"},
        "description": {"type": "string"},
        "validation_owner": {"type": "string"}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement", "priority"],
      "properties": {
        "id": {"type": "string"},
        "requirement": {"type": "string"},
        "priority": {"enum": ["must", "should", "could"]}
      }
    }
  }
}
