{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docxunravel.dev/schemas/template-contract-0.1.schema.json",
  "title": "DocXUnravel semantic template contract",
  "description": "Maps business-facing fields to IDs in one exact DocXUnravel semantic profile. It is distinct from the schema 1.1 patch contract.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "document_type", "binding", "fields"],
  "properties": {
    "contract_version": {"const": "0.1"},
    "document_type": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "source_sha256", "profile_sha256"],
      "properties": {
        "schema_version": {"const": "1.1"},
        "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
      "additionalProperties": {"$ref": "#/$defs/field"}
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required"],
      "properties": {
        "type": {"enum": ["text", "table_cell", "table_rows", "table_keyed_rows", "placeholder", "checkbox_group"]},
        "target": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "description": {"type": "string"},
        "data_path": {"type": "string", "pattern": "^($|/)"},
        "format_policy": {
          "enum": [
            "preserve_first_run",
            "preserve_common_formatting",
            "replace_text_only",
            "reject_mixed_runs"
          ]
        },
        "token": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
        "template_row": {"type": "integer", "minimum": 0},
        "columns": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "row_targets": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target"],
            "properties": {
              "target": {"type": "string", "pattern": "^c[0-9]+(?:\\.(?:p[0-9]+|t[0-9]+|r[0-9]+|c[0-9]+))+$"},
              "data_path": {"type": "string", "pattern": "^($|/)"},
              "format_policy": {
                "enum": ["preserve_first_run", "preserve_common_formatting", "replace_text_only", "reject_mixed_runs"]
              }
            }
          }
        },
        "empty_policy": {"enum": ["remove_template_row", "retain_empty_row", "error"]},
        "key": {
          "type": "object",
          "additionalProperties": false,
          "required": ["column"],
          "properties": {
            "column": {"type": "integer", "minimum": 0},
            "data_path": {"type": "string", "pattern": "^($|/)"},
            "match": {"enum": ["exact", "case_insensitive"]}
          }
        },
        "checkboxes": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
          "additionalProperties": {"type": "string", "minLength": 1}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"const": "placeholder"}}, "required": ["type"]},
          "then": {"required": ["token"]},
          "else": {"not": {"required": ["token"]}}
        },
        {
          "if": {"properties": {"type": {"const": "checkbox_group"}}, "required": ["type"]},
          "then": {
            "required": ["checkboxes"],
            "not": {"required": ["target"]}
          },
          "else": {"required": ["target"]}
        },
        {
          "if": {"properties": {"type": {"const": "table_rows"}}, "required": ["type"]},
          "then": {
            "required": ["template_row"],
            "oneOf": [
              {"required": ["columns"], "not": {"required": ["row_targets"]}},
              {"required": ["row_targets"], "not": {"required": ["columns"]}}
            ]
          }
        },
        {
          "if": {"properties": {"type": {"const": "table_keyed_rows"}}, "required": ["type"]},
          "then": {"required": ["key", "row_targets"]},
          "else": {"not": {"required": ["key"]}}
        },
        {
          "if": {"properties": {"type": {"enum": ["text", "table_cell"]}}, "required": ["type"]},
          "else": {"not": {"required": ["format_policy"]}}
        }
      ]
    }
  }
}
